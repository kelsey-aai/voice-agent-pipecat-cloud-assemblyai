# AssemblyAI: one key covers speech-to-text and text-to-speech
# https://www.assemblyai.com/dashboard/signup
ASSEMBLYAI_API_KEY=your_assemblyai_key

# OpenAI: the LLM
OPENAI_API_KEY=your_openai_key

# Daily: WebRTC transport on Pipecat Cloud (Pipecat Cloud > Settings > Daily)
DAILY_API_KEY=your_daily_key

# streaming (default, AssemblyAI STT 3.7 Realtime Agent) or sync (Sync API, Universal-3.6 Pro)
STT_MODE=streaming
